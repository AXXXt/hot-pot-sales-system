@import './styles/tokens.wxss';
@import './styles/base.wxss';

page {
  background: var(--bg-canvas);
  color: var(--text-primary);
  font-family: var(--font-family-base);
  box-sizing: border-box;
}

view,
text,
image,
button,
input,
textarea,
swiper,
scroll-view {
  box-sizing: border-box;
}

image {
  display: block;
}

button::after {
  border: 0;
}

button,
input,
textarea {
  font-family: var(--font-family-base);
}

view, text { overflow-wrap: break-word; letter-spacing: 0; }
button, input, textarea { border-radius: 8rpx; }
@media (prefers-reduced-motion: reduce) {
  view, button, text { animation: none !important; transition-duration: 0.01ms !important; }
}

.floating-cart-entry {
  position: fixed;
  z-index: 30;
  right: 28rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  min-width: 150rpx;
  height: 76rpx;
  padding: 0 18rpx 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #222625;
  color: #FFFFFF;
  box-shadow: none;
}

.floating-cart-entry__label {
  font-size: 25rpx;
  font-weight: 600;
}

.floating-cart-entry__count {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  color: var(--brand-primary);
  font-size: 22rpx;
  font-weight: 600;
}
