.orders-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg-canvas);
}
.load-more { margin: 24rpx 0; background: var(--bg-subtle); color: var(--text-primary); font-size: 26rpx; border-radius: 8rpx; }
.list-end { padding: 32rpx 0; text-align: center; font-size: 24rpx; color: var(--text-secondary); }

.orders-header {
  position: relative;
  overflow: hidden;
  padding: 32rpx 32rpx 20rpx;
  background: #FFFFFF;
}

.orders-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  line-height: 60rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.orders-sticky {
  position: relative;
  z-index: 2;
  margin: 0 32rpx 28rpx;
  padding: 0;
  border-bottom: 1rpx solid var(--border-default);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: none;
}

.orders-content,
.orders-loading,
.orders-error {
  margin: 0 32rpx;
}

.orders-content {
  padding-top: 4rpx;
}

.orders-loading,
.orders-error {
  padding: 80rpx 32rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--text-secondary);
  text-align: center;
  box-shadow: none;
}

.orders-retry {
  min-height: 76rpx;
  margin-top: 28rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-primary);
  color: #FFFFFF;
  font-weight: 600;
}
