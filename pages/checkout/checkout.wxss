.checkout-page {
  min-height: 100vh;
  padding-bottom: calc(192rpx + env(safe-area-inset-bottom));
  background: var(--brand-soft-gradient);
}

.checkout-header {
  position: relative;
  overflow: hidden;
  padding: 32rpx 32rpx 20rpx;
  background: #FFFFFF;
}

.checkout-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.checkout-empty {
  margin: 0 32rpx;
  padding: 80rpx 32rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  color: var(--text-secondary);
  font-size: 28rpx;
  text-align: center;
  box-shadow: none;
}

.checkout-body {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 0;
  padding: 0 32rpx;
}

.checkout-card {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-default);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: none;
}

.checkout-card__title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.checkout-card__sub {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.checkout-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 70rpx;
  padding: 12rpx 0;
}

.checkout-item + .checkout-item {
  border-top: 1rpx dashed var(--border-default);
}

.checkout-item__left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.checkout-item__name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.checkout-item__spec,
.checkout-item__qty,
.checkout-item__label {
  font-size: 23rpx;
  color: var(--text-secondary);
}

.checkout-item__right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.checkout-item__price,
.checkout-item__val {
  min-width: 120rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
}

.checkout-item__val--total {
  color: var(--brand-primary);
  font-size: 36rpx;
  font-weight: 600;
}

.payment-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.payment-option {
  position: relative;
  min-height: 108rpx;
  padding: 22rpx 72rpx 22rpx 24rpx;
  border: 2rpx solid var(--border-default);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5rpx;
  background: #f4f6f4;
}

.payment-option.active {
  border-color: var(--brand-primary);
  background: #f4f6f4;
}

.payment-option__name {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.payment-option__desc {
  color: var(--text-secondary);
  font-size: 23rpx;
}

.payment-option__check {
  position: absolute;
  top: 50%;
  right: 22rpx;
  width: 42rpx;
  height: 42rpx;
  margin-top: -21rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-primary);
  color: #FFFFFF;
  font-size: 24rpx;
}

.proof-upload {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx dashed rgba(34, 38, 37, 0.35);
  border-radius: 8rpx;
  background: #f4f6f4;
}

.proof-upload__preview {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 auto;
  border-radius: 8rpx;
  background: var(--bg-muted);
}

.proof-upload__content {
  min-width: 0;
  flex: 1;
}

.proof-upload__status,
.proof-upload__hint {
  display: block;
}

.proof-upload__status {
  color: var(--text-primary);
  font-size: 25rpx;
  font-weight: 600;
}

.proof-upload__hint {
  margin-top: 6rpx;
  color: var(--text-tertiary);
  font-size: 21rpx;
}

.proof-upload__button {
  flex: 0 0 auto;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  background: #f4f6f4;
  color: var(--brand-primary);
  font-size: 23rpx;
  font-weight: 600;
}

.checkout-remark {
  width: 100%;
  min-height: 130rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: 8rpx;
  background: #f4f6f4;
  color: var(--text-primary);
  font-size: 26rpx;
  line-height: 1.6;
}

.checkout-bar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border-default);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: none;
}

.checkout-bar__total {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.checkout-bar__label {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.checkout-bar__amount {
  color: var(--brand-primary);
  font-size: 36rpx;
  font-weight: 600;
}

.checkout-bar__btn {
  min-width: 236rpx;
  min-height: 88rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #222625;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: none;
}

.checkout-bar__btn.disabled {
  opacity: 0.5;
  box-shadow: none;
}

.checkout-split-notice {
  padding: 18rpx 22rpx;
  border-radius: 8rpx;
  background: #f4f6f4;
  color: var(--brand-primary);
  font-size: 24rpx;
  line-height: 1.55;
  box-shadow: none;
}

.checkout-brand-card__header,
.checkout-brand-card__subtotal {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.checkout-item__left { min-width: 0; }
.checkout-item__right { flex-shrink: 0; }
.checkout-bar__total { min-width: 0; }
.checkout-bar__amount { font-size: 32rpx; overflow-wrap: anywhere; }
.checkout-bar__btn { margin-left: 20rpx; flex-shrink: 0; }
.checkout-empty__action { padding: 24rpx; margin-top: 32rpx; border-radius: 8rpx; background: var(--brand-primary); color: white; }

.checkout-brand-card__header .checkout-card__title {
  margin-bottom: 0;
}

.checkout-brand-card__tag {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #f4f6f4;
  color: var(--brand-primary);
  font-size: 21rpx;
  font-weight: 600;
}

.checkout-brand-card__subtotal {
  margin-top: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border-subtle);
  color: var(--brand-primary);
  font-size: 25rpx;
  font-weight: 600;
}
