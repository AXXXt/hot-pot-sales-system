.cart-page {
  min-height: 100vh;
  padding-bottom: calc(192rpx + env(safe-area-inset-bottom));
  background: var(--bg-canvas);
}

.cart-header {
  position: relative;
  overflow: hidden;
  padding: 32rpx 32rpx 20rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  background: #FFFFFF;
}

.cart-title,
.cart-count {
  position: relative;
  z-index: 1;
}

.cart-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cart-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.cart-empty {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 32rpx;
  padding: 72rpx 40rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: none;
}

.cart-empty__icon {
  width: 116rpx;
  height: 116rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f6f4;
  font-size: 62rpx;
}

.cart-empty__title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cart-empty__desc {
  padding: 0 24rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--text-secondary);
  text-align: center;
}

.cart-empty__btn {
  min-width: 220rpx;
  min-height: 88rpx;
  margin-top: 36rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #222625;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: none;
}

.cart-body {
  position: relative;
  z-index: 2;
  margin-top: 0;
  padding: 0 32rpx;
}

.cart-items {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.cart-item {
  position: relative;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-default);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: none;
}

.cart-item.is-unavailable {
  background: rgba(255, 255, 255, 0.72);
  opacity: 0.72;
}

.cart-item__info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-right: 70rpx;
}

.cart-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cart-item__spec,
.cart-item__price {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.cart-item__error {
  font-size: 23rpx;
  color: var(--status-danger);
}

.cart-item__remove {
  position: absolute;
  top: 24rpx;
  right: 0;
  padding: 8rpx 12rpx;
  color: var(--status-danger);
  font-size: 23rpx;
}

.cart-item__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.cart-item__qty {
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid var(--border-default);
  border-radius: 8rpx;
  background: #f4f6f4;
}

.qty-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-primary);
  font-size: 34rpx;
  font-weight: 600;
}

.qty-val {
  min-width: 64rpx;
  text-align: center;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.cart-item__amount {
  color: var(--brand-primary);
  font-size: 34rpx;
  font-weight: 600;
}

.cart-bar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border: 1rpx solid rgba(34, 38, 37, 0.08);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: none;
}

.cart-bar__total {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.cart-bar__label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.cart-bar__amount {
  color: var(--brand-primary);
  font-size: 36rpx;
  font-weight: 600;
}

.cart-bar__btn {
  min-width: 220rpx;
  min-height: 88rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #222625;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: none;
}

.cart-bar__btn.disabled {
  background: #d5dbd6;
  box-shadow: none;
}

.cart-brand-notice {
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 8rpx;
  background: #f4f6f4;
  color: var(--brand-primary);
  font-size: 24rpx;
  line-height: 1.5;
}

.cart-item__brand {
  display: block;
  margin-bottom: 6rpx;
  color: var(--brand-primary);
  font-size: 21rpx;
  font-weight: 600;
}

.cart-validation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 20rpx;
  background: var(--bg-muted, #f4f6f4);
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.cart-validation.is-error { color: var(--status-danger); }
.cart-validation__retry {
  flex-shrink: 0;
  margin: 0;
  color: var(--brand-primary);
  background: #FFFFFF;
  font-size: 24rpx;
}
.qty-btn.is-disabled { color: var(--text-secondary); opacity: 0.45; }
.cart-bar__total { min-width: 0; }
.cart-bar__amount { font-size: 32rpx; overflow-wrap: anywhere; }
.cart-bar__btn { margin-left: 20rpx; flex-shrink: 0; }
