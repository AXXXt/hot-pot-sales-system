.profile-detail-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg-canvas);
}
.profile-detail-page button { width: 100%; border-radius: 8rpx; font-size: 26rpx; font-weight: 400; }
.profile-detail-page button::after { border: 0; }
.detail-button { margin-top: 28rpx; padding: 12rpx 24rpx; background: var(--bg-subtle); color: var(--text-primary); }
.detail-link { padding: 16rpx 0; margin-top: 16rpx; background: transparent; color: var(--text-secondary); }
.detail-note { display: block; color: var(--text-secondary); font-size: 24rpx; line-height: 1.8; margin-top: 24rpx; }
.price-search { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; background: var(--bg-subtle); padding: 8rpx 20rpx; border-radius: 8rpx; }
.price-search input { flex: 1; min-width: 0; height: 72rpx; font-size: 27rpx; }
.price-search button { padding: 0; margin: 0; width: 72rpx; height: 72rpx; background: transparent; }

.profile-detail-state {
  padding: 160rpx 32rpx;
  color: var(--text-secondary);
  text-align: center;
  font-size: 28rpx;
}

.profile-detail-state--error {
  color: var(--status-danger);
}

.profile-detail-card {
  padding: 16rpx 0;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: none;
}

.profile-detail-card__title {
  display: block;
  margin-bottom: 20rpx;
  color: var(--brand-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.profile-detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 76rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border-subtle);
}

.profile-detail-row__label {
  flex: 0 0 160rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.profile-detail-row__value {
  flex: 1;
  color: var(--text-primary);
  font-size: 27rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.profile-detail-action {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #f4f6f4;
  color: var(--brand-primary);
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
}

.price-rule {
  margin: 0;
  background: transparent;
  text-align: left;
  line-height: 1.5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--border-subtle);
}
.profile-detail-page .price-rule { border-radius: 0; }

.price-rule__main {
  min-width: 0;
  flex: 1;
}

.price-rule__name,
.price-rule__spec,
.price-rule__base,
.price-rule__unit {
  display: block;
}

.price-rule__name {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.price-rule__spec {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
}

.price-rule__amount {
  flex: 0 0 auto;
  text-align: right;
}

.price-rule__price {
  color: var(--brand-primary);
  font-size: 31rpx;
  font-weight: 600;
}

.price-rule__base,
.price-rule__unit {
  margin-top: 6rpx;
  color: var(--text-tertiary);
  font-size: 21rpx;
}

.profile-detail-empty {
  padding: 90rpx 20rpx;
  border-top: 1rpx solid var(--border-subtle);
  color: var(--text-secondary);
  font-size: 26rpx;
  text-align: center;
}
