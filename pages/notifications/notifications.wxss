.notices-page { padding: 32rpx; box-sizing: border-box; }
.notices-heading, .notice-heading, .notice-footer { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; }
.notices-heading { margin-bottom: 36rpx; }
.notices-title { display: block; font-size: 40rpx; font-weight: 600; }
.notices-subtitle { display: block; margin-top: 10rpx; font-size: 23rpx; color: var(--text-secondary); }
.read-all { width: auto; padding: 14rpx 16rpx; margin: 0; font-size: 24rpx; line-height: 1.5; flex-shrink: 0; color: #43715b; background: #f4f6f4; }
.read-all::after { border: 0; }
.notice { padding: 28rpx 0; border-bottom: 1rpx solid var(--border-default); }
.notice-title { font-size: 29rpx; font-weight: 500; }
.is-unread .notice-title { font-weight: 700; }
.is-unread .notice-title::before { content: '●'; color: #c4461b; font-size: 18rpx; margin-right: 10rpx; }
.notice-time, .notice-footer { color: var(--text-secondary); font-size: 22rpx; }
.notice-content { display: block; margin: 18rpx 0; font-size: 26rpx; line-height: 1.7; color: var(--text-secondary); }
.notice-footer { overflow-wrap: anywhere; }
.notices-state { padding: 56rpx 0; text-align: center; color: var(--text-secondary); font-size: 25rpx; }
