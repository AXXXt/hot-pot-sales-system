.profile-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg-canvas);
}

.profile-header {
  position: relative;
  overflow: hidden;
  min-height: 280rpx;
  padding: 54rpx 32rpx 142rpx;
  background: var(--brand-gradient);
}

.profile-header::after {
  content: '';
  position: absolute;
  width: 460rpx;
  height: 460rpx;
  right: -220rpx;
  top: -220rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

.profile-title {
  position: relative;
  z-index: 1;
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.profile-login-card,
.profile-content {
  position: relative;
  z-index: 2;
}

.profile-login-card {
  margin: -104rpx 32rpx 0;
  padding: 48rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: var(--shadow-lg);
  text-align: center;
}

.profile-login-card__title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 38rpx;
  font-weight: 750;
  color: var(--text-primary);
}

.profile-login-card__desc {
  display: block;
  margin-bottom: 34rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--text-secondary);
}

.profile-login-card__btn {
  min-height: 92rpx;
  margin-bottom: 16rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--brand-accent), var(--brand-primary));
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(141, 28, 28, 0.22);
}

.profile-login-card__btn--secondary {
  margin-bottom: 0;
  background: #F7E9E6;
  color: var(--brand-primary);
  box-shadow: none;
}

.profile-content {
  margin: -104rpx 32rpx 0;
}

.profile-card,
.profile-menu {
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: var(--shadow-lg);
}

.profile-card {
  padding: 34rpx;
  margin-bottom: 24rpx;
}

.profile-card__label {
  display: block;
  margin-bottom: 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand-primary);
}

.profile-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  border-top: 1rpx solid var(--border-subtle);
}

.profile-card__key {
  font-size: 27rpx;
  color: var(--text-secondary);
}

.profile-card__val {
  max-width: 66%;
  font-size: 27rpx;
  font-weight: 650;
  color: var(--text-primary);
  text-align: right;
}

.profile-card__val--level {
  padding: 7rpx 16rpx;
  border-radius: var(--radius-full);
  background: #FFF0ED;
  color: var(--brand-primary);
  font-size: 23rpx;
}

.profile-menu {
  overflow: hidden;
}

.profile-menu__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 34rpx;
  border-top: 1rpx solid var(--border-subtle);
  color: var(--text-primary);
  font-size: 29rpx;
}

.profile-menu__item:first-child {
  border-top: 0;
}

.profile-menu__arrow {
  color: var(--text-tertiary);
  font-size: 30rpx;
}

.profile-menu__logout {
  color: var(--status-danger);
}
