.account-page { padding: 16rpx 32rpx 48rpx; background: var(--bg-canvas); }
.account-page button { width: auto; margin: 0; padding: 0; border-radius: 0; background: transparent; color: var(--text-primary); font-size: 26rpx; line-height: 1.5; font-weight: 400; }
.account-page button::after { border: 0; }
.identity-tools, .identity-bottom, .section-heading, .credit-caption, .service-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.brand-mark { width: 132rpx; height: 74rpx; }
.account-page .text-button { flex-shrink: 0; min-height: 88rpx; display: flex; align-items: center; color: var(--text-secondary); font-size: 24rpx; }
.identity { padding: 24rpx 0 12rpx; }
.store-name { display: block; font-size: 40rpx; font-weight: 600; line-height: 1.4; word-break: break-all; }
.identity-contact { display: block; margin-top: 14rpx; font-size: 26rpx; color: var(--text-secondary); }
.identity-status { color: var(--status-success); font-size: 23rpx; line-height: 1.7; }
.level { color: var(--text-secondary); }
.account-section { border-top: 1rpx solid var(--border-default); padding: 14rpx 0 24rpx; }
.section-heading { min-height: 80rpx; font-size: 29rpx; font-weight: 600; }
.section-heading .text-button { font-weight: 400; }
.order-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 8rpx 0; }
.account-page .order-entry { min-height: 116rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 8rpx; font-size: 25rpx; }
.order-entry + .order-entry { border-left: 1rpx solid var(--border-default); }
.order-count { font-size: 38rpx; font-weight: 600; }
.has-count { color: var(--brand-accent); }
.credit-caption { color: var(--text-secondary); font-size: 24rpx; }
.credit-caption .text-button { min-height: 88rpx; }
.credit-amount { display: block; font-size: 46rpx; font-weight: 600; font-variant-numeric: tabular-nums; word-break: break-all; }
.credit-meta { display: flex; flex-wrap: wrap; gap: 10rpx 24rpx; margin-top: 16rpx; color: var(--text-secondary); font-size: 23rpx; }
.recent-order { padding: 16rpx 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 16rpx; }
.recent-main { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 280rpx; }
.recent-image { width: 100rpx; height: 100rpx; border-radius: 8rpx; flex-shrink: 0; background: var(--bg-subtle); }
.image-placeholder { display: flex; align-items: center; justify-content: center; }
.image-placeholder image { width: 44rpx; height: 44rpx; opacity: .6; }
.recent-info { min-width: 0; }
.recent-name { display: block; font-size: 27rpx; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.muted { display: block; color: var(--text-secondary); font-size: 23rpx; line-height: 1.7; }
.account-page .repeat-button { flex: 0 0 auto; border: 1rpx solid var(--border-default); padding: 12rpx 18rpx; border-radius: 8rpx; min-height: 88rpx; font-size: 24rpx; display: flex; align-items: center; }
.account-page .repeat-button[disabled] { color: var(--text-disabled); }
.account-page .service-row { min-height: 100rpx; width: 100%; text-align: left; border-bottom: 1rpx solid var(--border-default); font-size: 28rpx; }
.service-section { padding-bottom: 0; }
.chevron { color: var(--text-secondary); font-size: 34rpx; }
.inline-state { padding: 20rpx 0; color: var(--text-secondary); font-size: 25rpx; }
.state { padding: 90rpx 0; text-align: center; color: var(--text-secondary); }
.state .text-button { justify-content: center; width: 100%; }
.guest { padding: 40rpx 0; }
.account-page .primary-action { margin-top: 32rpx; padding: 24rpx; color: white; background: var(--brand-primary); border-radius: 8rpx; }
