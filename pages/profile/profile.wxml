<view class="page account-page">
  <view class="identity-tools">
    <image class="brand-mark" src="/assets/brand/logo.jpg" mode="aspectFit" />
    <button class="text-button" bindtap="goSettings">账户设置 ›</button>
  </view>
  <view wx:if="{{!isLoggedIn}}" class="guest">
    <text class="store-name">欢迎来到唯哆鲜</text>
    <text class="muted">登录后查看门店订单与专属价格</text>
    <button class="primary-action" bindtap="goLogin">登录</button>
    <button class="text-button" bindtap="goRegister">注册门店</button>
  </view>
  <view wx:elif="{{!hasProfile}}" class="state">
    <text>{{error || '正在加载门店资料…'}}</text>
    <button wx:if="{{error}}" class="text-button" bindtap="refreshProfile">重新加载</button>
  </view>
  <block wx:else>
    <view class="identity">
      <text class="store-name">{{storeName}}</text>
      <text class="identity-contact">{{contactName}} · {{phone}}</text>
      <view class="identity-bottom">
        <text class="identity-status">{{statusText}}<text class="level"> · {{levelName}}</text></text>
        <button class="text-button" data-type="company" bindtap="onProtectedTap">企业资料 ›</button>
      </view>
    </view>
    <shipment-reminder id="shipment-reminder" />
    <block wx:if="{{hasCustomer}}">
      <button class="service-row" bindtap="goNotifications"><text>站内消息{{unreadNotices ? ' · ' + unreadNotices + '条未读' : ''}}</text><text class="chevron">›</text></button>
      <view class="account-section">
        <view class="section-heading"><text>我的订单</text><button class="text-button" bindtap="goOrders">全部订单 ›</button></view>
        <view wx:if="{{overviewLoading}}" class="inline-state">正在加载订单…</view>
        <view wx:elif="{{overviewError}}" class="inline-state"><text>{{overviewError}}</text><button class="text-button" bindtap="retryOverview">重试</button></view>
        <view wx:else class="order-grid">
          <button wx:for="{{orderEntries}}" wx:key="status" class="order-entry" data-status="{{item.status}}" bindtap="goOrders">
            <text class="order-count {{item.count ? 'has-count' : ''}}">{{item.count}}</text><text>{{item.label}}</text>
          </button>
        </view>
      </view>
      <view wx:if="{{creditEnabled}}" class="account-section credit-section">
        <view class="section-heading"><text>账期账户</text><button class="text-button" data-type="credit" bindtap="onProtectedTap">查看详情 ›</button></view>
        <view class="credit-caption"><text>可用额度（元）</text><button class="text-button" bindtap="toggleAmounts" aria-label="{{hideAmounts ? '显示金额' : '隐藏金额'}}">{{hideAmounts ? '显示金额' : '隐藏金额'}}</button></view>
        <text class="credit-amount">{{hideAmounts ? '••••' : creditRemaining}}</text>
        <view class="credit-meta"><text>总额度 {{hideAmounts ? '••••' : creditLimit}}</text><text>已用 {{hideAmounts ? '••••' : creditUsed}}</text><text>账期 {{creditDays}}</text></view>
      </view>
      <view class="account-section">
        <view class="section-heading"><text>最近采购</text><button class="text-button" data-status="completed" bindtap="goOrders">采购记录 ›</button></view>
        <view wx:if="{{overviewLoading}}" class="inline-state">正在加载采购记录…</view>
        <view wx:elif="{{overviewError}}" class="inline-state">采购记录暂不可用</view>
        <view wx:elif="{{!recentOrders.length}}" class="inline-state"><text>暂无已完成的采购</text><button class="text-button" bindtap="goShop">去选品 ›</button></view>
        <view wx:for="{{recentOrders}}" wx:key="id" class="recent-order">
          <view class="recent-main" data-id="{{item.id}}" bindtap="openOrder">
            <image wx:if="{{item.image && !item.imageFailed}}" class="recent-image" src="{{item.image}}" mode="aspectFill" data-index="{{index}}" binderror="onImageError" />
            <view wx:else class="recent-image image-placeholder"><image src="/assets/brand/orders.png" mode="aspectFit" /></view>
            <view class="recent-info"><text class="recent-name">{{item.productName}}{{item.skuCount > 1 ? ' 等' : ''}}</text><text class="muted">{{item.spec}} · {{item.skuCount}} 个规格</text><text class="muted">{{item.date}}</text></view>
          </view>
          <button class="repeat-button" data-id="{{item.id}}" bindtap="onRepeat" disabled="{{repeatBuying}}">再次采购</button>
        </view>
      </view>
      <view class="account-section service-section">
        <view class="section-heading"><text>采购服务</text></view>
        <button class="service-row" bindtap="goServiceRequests"><text>服务申请与进度</text><text class="chevron">›</text></button>
        <button class="service-row" data-type="prices" bindtap="onProtectedTap"><text>协议价格</text><text class="chevron">›</text></button>
        <button class="service-row" data-type="address" bindtap="onProtectedTap"><text>收货信息</text><text class="chevron">›</text></button>
      </view>
    </block>
  </block>
  <button class="service-row" bindtap="goHelp"><text>联系与帮助</text><text class="chevron">›</text></button>
</view>
