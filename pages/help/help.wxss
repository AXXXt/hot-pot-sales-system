.help-page { padding: 32rpx 32rpx 60rpx; }
.help-title { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.help-note { display: block; color: var(--text-secondary); font-size: 26rpx; line-height: 1.8; }
.support-phone { display: block; font-size: 40rpx; font-weight: 600; margin-bottom: 12rpx; word-break: break-all; }
.support-actions { display: flex; align-items: center; gap: 32rpx; margin-top: 24rpx; }
.help-page button { width: 100%; font-size: 27rpx; border-radius: 8rpx; font-weight: 400; }
.support-actions button { width: auto; }
.help-page button::after { border: 0; }
.help-link { margin: 0; padding: 12rpx 0; background: transparent; color: var(--text-secondary); }
.call-button { margin: 0; background: var(--brand-primary); color: white; padding: 10rpx 32rpx; }
.faq-title { margin-top: 56rpx; }
.question { border-bottom: 1rpx solid var(--border-default); }
.question-title { margin: 0; padding: 28rpx 0; min-height: 100rpx; line-height: 1.6; display: flex; justify-content: space-between; gap: 24rpx; text-align: left; background: transparent; color: var(--text-primary); }
.answer { display: block; padding: 0 0 28rpx; color: var(--text-secondary); font-size: 26rpx; line-height: 1.9; }
.feedback-button { background: var(--bg-subtle); color: var(--text-primary); margin-top: 48rpx; }
