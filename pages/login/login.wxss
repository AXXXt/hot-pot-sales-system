.auth-page { min-height: 100vh; padding: 24rpx 40rpx calc(48rpx + env(safe-area-inset-bottom)); background: #FFFFFF; }
.auth-done, .auth-pending, .auth-form { width: 100%; max-width: 720rpx; margin: 0 auto; }
.auth-done, .auth-pending__card { padding: 80rpx 0; text-align: center; }
.auth-form__card { padding: 0; background: white; }
.auth-done__check, .auth-pending__ring { width: 104rpx; height: 104rpx; margin: 0 auto 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f1f5f2; color: var(--brand-secondary); }
.auth-done__title, .auth-pending__title, .auth-form__title { display: block; font-size: 40rpx; line-height: 1.4; font-weight: 600; color: var(--text-primary); }
.auth-done__desc, .auth-pending__desc, .auth-form__subtitle { display: block; margin-top: 12rpx; font-size: 26rpx; line-height: 1.7; color: var(--text-secondary); }
.auth-form__subtitle { margin-bottom: 40rpx; }
.auth-pending__info { padding: 28rpx 0; margin-top: 32rpx; border-top: 1rpx solid var(--border-default); border-bottom: 1rpx solid var(--border-default); }
.auth-pending__info-label, .auth-pending__hint-text { display: block; font-size: 26rpx; color: var(--text-secondary); }
.auth-pending__info-value { display: block; margin-top: 12rpx; font-size: 30rpx; }
.auth-pending__action, .auth-pending__hint { margin-top: 32rpx; }
.auth-pending__arrow { display: block; margin-top: 12rpx; color: var(--text-secondary); }
.auth-form__field { margin-bottom: 28rpx; }
.auth-form__label { display: block; margin-bottom: 14rpx; font-size: 26rpx; color: var(--text-primary); }
.auth-form__input, .auth-form__picker, .auth-form__prefix { min-height: 88rpx; border: 1rpx solid var(--border-default); border-radius: 8rpx; background: #FFFFFF; }
.auth-form__input { height: 88rpx; padding: 0 20rpx; color: var(--text-primary); font-size: 28rpx; }
.auth-form__placeholder { color: var(--text-secondary); font-size: 26rpx; }
.auth-form__picker { padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; font-size: 28rpx; gap: 16rpx; }
.auth-form__picker-arrow { color: var(--text-secondary); }
.auth-form__divider { height: 1rpx; margin: 32rpx 0; background: var(--border-default); }
.auth-form__phone-row { display: flex; align-items: center; gap: 16rpx; }
.auth-form__prefix { display: flex; align-items: center; padding: 0 20rpx; font-size: 26rpx; background: var(--bg-subtle); }
.auth-form__input--phone, .auth-form__input--code { flex: 1; min-width: 0; }
.auth-form__code-btn { min-height: 88rpx; display: flex; align-items: center; font-size: 26rpx; color: var(--brand-secondary); white-space: nowrap; padding: 0 8rpx; }
.auth-form__code-btn--off { color: var(--text-disabled); }
.auth-form__agree { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; margin: 28rpx 0; font-size: 24rpx; color: var(--text-secondary); }
.auth-form__agree-row { display: flex; align-items: center; min-height: 64rpx; }
.auth-form__agree-link { color: var(--brand-secondary); padding: 12rpx 0; }
.auth-form__submit, .auth-pending__login-btn { min-height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 8rpx; background: var(--brand-primary); color: white; font-size: 30rpx; font-weight: 600; }
.auth-form__submit--loading, .auth-pending__login-btn--loading { opacity: .5; }
.auth-form__switch, .auth-pending__back { min-height: 88rpx; display: flex; align-items: center; justify-content: center; margin-top: 16rpx; color: var(--brand-secondary); font-size: 26rpx; }
