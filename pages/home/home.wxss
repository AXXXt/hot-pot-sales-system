.home {
  min-height: 100vh;
  padding: 0 38rpx calc(150rpx + env(safe-area-inset-bottom));
  background: #fff;
  color: #222625;
  letter-spacing: 0;
}
.home button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: none;
  color: inherit;
  font-size: 26rpx;
  line-height: 1.5;
}
.home__navigation {
  display: block;
  margin-bottom: 16rpx;
  position: sticky;
  top: 0;
  z-index: 40;
  margin-left: -38rpx;
  margin-right: -38rpx;
  padding-left: 38rpx;
  background: #fff;
}
.home__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 26rpx;
}
.home__header-left {
  min-width: 0;
}
.home__eyebrow {
  display: block;
  font-size: 22rpx;
  color: #666e68;
  line-height: 1.5;
  margin-bottom: 10rpx;
}
.home__title {
  display: block;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.home .home__orders {
  width: 88rpx;
  flex-shrink: 0;
  min-width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.home__orders image {
  width: 38rpx;
  height: 38rpx;
}
.home__search {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 20rpx;
  min-height: 88rpx;
  background: #f4f6f4;
  border-radius: 6rpx;
  margin-bottom: 28rpx;
}
.home__search image {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.home__search input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  height: 88rpx;
}
.home__search button {
  min-width: 64rpx;
  min-height: 88rpx;
  font-size: 24rpx;
  color: #43715b;
}
.home__editorial {
  position: relative;
  height: 246rpx;
  overflow: hidden;
  background: #f4f6f4;
}
.home__editorial-image {
  width: 100%;
  height: 100%;
}
.home__editorial-copy {
  position: absolute;
  left: 28rpx;
  top: 28rpx;
}
.home__editorial-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}
.home__editorial-sub {
  display: block;
  font-size: 21rpx;
  margin-top: 8rpx;
}
.home__editorial-link {
  display: block;
  font-size: 22rpx;
  margin-top: 18rpx;
}
.home__image-note {
  position: absolute;
  bottom: 8rpx;
  right: 10rpx;
  font-size: 16rpx;
  color: #343a35;
  background: #ffffffd9;
  padding: 2rpx 6rpx;
}
.home__account {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #e5e8e5;
}
.home__credit {
  width: 55%;
  border-right: 1rpx solid #e5e8e5;
  padding-right: 18rpx;
  min-height: 90rpx;
}
.home__amount {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.home__credit-term {
  font-size: 20rpx;
  color: #666e68;
}
.home .home__order-link {
  display: flex;
  flex: 1;
  text-align: left;
  align-items: center;
  justify-content: space-between;
  padding-left: 30rpx;
  min-height: 90rpx;
  font-size: 25rpx;
}
.home__feed-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  border-bottom: 1rpx solid #e5e8e5;
}
.home__feed-heading segmented-control {
  flex: 1;
  min-width: 0;
}
.home__feed-heading button {
  min-height: 88rpx;
  min-width: 70rpx;
  font-size: 22rpx;
}
.home__error {
  padding: 60rpx 0;
  text-align: center;
  color: #666e68;
  font-size: 28rpx;
}
.home__error button {
  color: #43715b;
  min-height: 88rpx;
  margin-top: 18rpx;
}
.home .home__cart {
  position: fixed;
  z-index: 30;
  left: 30rpx;
  right: 30rpx;
  bottom: 16rpx;
  width: auto;
  height: 100rpx;
  padding: 0 26rpx;
  border: 0;
  border-radius: 6rpx;
  background: #222625;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 6rpx 18rpx #22262514;
}
.home__cart image {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}
.home__cart .floating-cart-entry__count {
  background: #59635c;
  color: #fff;
  font-size: 20rpx;
  height: 34rpx;
  min-width: 34rpx;
  font-weight: 400;
}
.home__cart-total {
  font-size: 28rpx;
  flex: 1;
  text-align: left;
}
.home__cart-label {
  font-size: 23rpx;
}
.home__search button,
.home__feed-heading button {
  display: flex;
  align-items: center;
  justify-content: center;
}
.home__account {
  padding: 24rpx 0;
}
