<view class="home"><view class="home__navigation"><brand-navigation /></view><view class="home__header"><view class="home__header-left"><text class="home__eyebrow">门店采购</text><text class="home__title">{{userInfo.isLogin ? userInfo.companyName : '欢迎来到唯哆鲜'}}</text></view><button size="mini" class="home__orders" bindtap="goOrders" aria-label="查看订单"><image src="/assets/brand/orders.png"></image></button></view><view class="home__search"><image src="/assets/brand/search.png"></image><input
      value="{{keyword}}"
      bindinput="onSearchInput"
      bindconfirm="goSearch"
      confirm-type="search"
      placeholder="搜索食材名称"
      aria-label="搜索食材名称"
    /><button size="mini" bindtap="goSearch">搜索</button></view><view
    class="home__editorial"
    bindtap="goCategory"
    role="link"
    aria-label="浏览食材目录"
  ><image
      class="home__editorial-image"
      src="/assets/brand/editorial.jpg"
      mode="aspectFill"
    ></image><view class="home__editorial-copy"><text class="home__eyebrow">日常好食材</text><text class="home__editorial-title">鲜香好滋味</text><text class="home__editorial-sub">为每一天的餐饮经营</text><text class="home__editorial-link">去选品 →</text></view><text class="home__image-note">食材场景示意</text></view><view class="home__account"><view class="home__credit" bindtap="goProfile"><text class="home__eyebrow">可用账期</text><text class="home__amount">{{userInfo.isLogin ? '¥' + userInfo.creditRemaining : '登录后查看'}}</text><text wx:if="{{userInfo.isLogin}}" class="home__credit-term">{{userInfo.creditDays}}天账期</text></view><button size="mini" class="home__order-link" bindtap="goOrders"><view><text class="home__eyebrow">我的订单</text><text>查看采购进度</text></view><text>›</text></button></view><view class="home__section home__feed-heading"><segmented-control
      items="{{feedTabs}}"
      activeId="{{activeFeed}}"
      bind:change="onFeedChange"
    /><button size="mini" bindtap="goCategory">全部 ›</button></view><view class="home__section home__products"><view wx:if="{{loading}}"><skeleton /><view style="height: 24rpx"></view><skeleton /></view><view wx:elif="{{error}}" class="home__error"><text>商品加载失败</text><button size="mini" bindtap="loadFeedProducts">重新加载</button></view><view wx:elif="{{products.length}}"><product-row
        wx:for="{{products}}"
        wx:key="id"
        productId="{{item.id}}"
        name="{{item.name}}"
        brandText="{{item.brandText}}"
        spec="{{item.spec}}"
        price="{{item.price}}"
        priceUnit="{{item.priceUnit}}" priceFrom="{{item.priceFrom}}"
        statusText="{{item.stockText}}"
        statusVariant="{{item.statusVariant}}"
        subText="{{item.subText}}"
        image="{{item.image}}"
        bind:tap="goProductDetail"
        bind:add="onProductAdd"
      /></view><empty-state
      wx:else
      title="{{activeFeed === 'frequent' ? '暂无常购商品' : activeFeed === 'new' ? '暂无新品' : '暂无热销商品'}}"
      desc="{{activeFeed === 'frequent' ? '完成采购后，常用食材会出现在这里。' : '可以前往食材目录继续选购。'}}"
    /></view><button size="mini"
    class="floating-cart-entry home__cart"
    bindtap="goCart"
    aria-label="查看进货单"
  ><image src="/assets/brand/cart-white.png"></image><text class="floating-cart-entry__count">{{cartCount}}</text><text class="home__cart-total">{{cartCount ? '¥' + cartTotal : '进货单'}}</text><text class="home__cart-label">查看进货单</text><text>›</text></button></view>
