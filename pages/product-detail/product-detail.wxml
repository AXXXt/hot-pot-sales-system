<view class="page product-detail-page"><view class="detail-navigation"><brand-navigation back="{{true}}" /></view><view wx:if="{{loading}}" class="product-detail-skeleton"><text>正在加载商品…</text></view><view wx:elif="{{error}}" class="product-detail-error"><text class="product-detail-error__title">{{error}}</text><button size="mini" class="product-detail-error__retry" bindtap="onRetry">重新加载</button></view><view wx:else class="product-detail-body"><view class="product-media"><view
        wx:if="{{!imageList.length}}"
        class="product-media__empty"
      ><text>暂无商品图片</text></view><swiper
        wx:elif="{{imageList.length > 1}}"
        class="product-media__swiper"
        circular="true"
        autoplay="false"
        current="{{imageIndex}}"
        bindchange="onSwiperChange"
      ><swiper-item wx:for="{{imageList}}" wx:key="index"><view wx:if="{{failedImages[index]}}" class="product-media__empty"><text>图片加载失败，请查看其他图片</text></view><image wx:else data-index="{{index}}" bindtap="onPreviewImage"
            class="product-media__image"
            src="{{item}}"
            mode="aspectFit"
            binderror="onImageFail"
          ></image></swiper-item></swiper><image
        wx:elif="{{!failedImages[0]}}" data-index="0" bindtap="onPreviewImage"
        class="product-media__image"
        src="{{imageList[0]}}"
        mode="aspectFit"
        binderror="onImageFail"
      ></image><view wx:else class="product-media__empty"><text>图片加载失败，请稍后重试</text></view><view wx:if="{{imageList.length > 1}}" class="product-media__dots">{{imageIndex + 1}} / {{imageList.length}}</view></view><view class="product-section product-intro"><text class="product-brand">{{product.brand_name}}{{product.brand_name && product.category_name ? ' / ' : ''}}{{product.category_name}}</text><text class="product-name">{{product.name}}</text><text class="product-support" wx:if="{{product.subtitle && product.subtitle !== product.name}}">{{product.subtitle}}</text><view class="price-row"><view><text class="price-row__price">{{displayPrice}}</text><text class="price-row__unit">{{saleUnitText}}</text></view><text class="price-note">以确认报价为准</text></view><view class="price-support"><text wx:if="{{customerPriceText}}">{{customerPriceText}}</text><text wx:if="{{basePriceText}}">{{basePriceText}}</text></view><view class="product-meta"><text>{{stockText}}</text><text>{{minOrderText}}起订</text><text>{{deliveryText}}</text></view></view><view class="product-section"><text class="section-title">选择规格</text><view class="sku-list" wx:if="{{skus.length}}"><button size="mini"
          wx:for="{{skus}}"
          wx:key="id"
          class="sku-item {{selectedSkuId == item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectSku"
          disabled="{{item.sold_out}}"
        ><text class="sku-item__name">{{item.spec_text || item.name}}</text><text class="sku-item__desc">{{item.sale_unit || '单位待确认'}}{{item.sold_out ? ' · 售罄' : ''}}</text><text wx:if="{{selectedSkuId == item.id}}" class="sku-item__check">✓</text></button></view><text wx:if="{{skuError}}" class="inline-error">{{skuError}}</text><view wx:if="{{packageOptions.length > 1}}" class="package-picker"><text>采购单位</text><picker range="{{packageOptions}}" range-key="label" value="{{packageIndex}}" bindchange="onPackageChange"><view class="package-picker__value">{{packageOptions[packageIndex].label}} ▾</view></picker><text class="package-picker__hint">{{packageHint}}</text></view><view class="quantity-row"><view><text class="quantity-title">采购数量</text><text class="quantity-unit">{{packageUnit || selectedSku.sale_unit || ''}}</text></view><quantity-stepper id="quantity-stepper"
          value="{{quantity}}"
          min="{{minQuantity}}"
          max="{{maxQuantity}}"
          disabled="{{quantityDisabled}}"
          bind:change="onQuantityChange"
        /></view><button size="mini"
        class="buy-now"
        bindtap="onBuyNow"
        disabled="{{!canBuy || skuLoading}}"
      >直接下单 ›</button></view><view class="product-section" wx:if="{{paramList.length}}"><text class="section-title">商品参数</text><view class="param-list"><view wx:for="{{paramList}}" wx:key="label" class="param-item"><text class="param-item__label">{{item.label}}</text><text class="param-item__value">{{item.value}}</text></view></view></view><view class="product-section" wx:if="{{product.description}}"><text class="section-title">商品说明</text><text class="product-desc">{{product.description}}</text></view></view><view class="product-actionbar" wx:if="{{!error && !loading}}"><button size="mini"
      class="product-actionbar__cart"
      bindtap="onOpenCart"
      aria-label="查看进货单"
    ><image src="/assets/brand/cart.png"></image><text wx:if="{{inCartCount > 0}}" class="product-actionbar__badge">{{inCartCount}}</text></button><view class="product-actionbar__total"><text>预计金额</text><text class="product-actionbar__amount">{{estimatedTotal}}</text></view><button size="mini"
      class="product-actionbar__primary"
      disabled="{{!canBuy || skuLoading}}"
      bindtap="onAddToCart"
    >加入进货单<text>+</text></button></view><cart-sheet
    visible="{{cartSheetVisible}}"
    bind:close="onCloseCart"
    bind:change="onCartChange"
  /></view>
