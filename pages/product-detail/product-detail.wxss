.product-detail-page {
  min-height: 100vh;
  padding: 0 0 calc(160rpx + env(safe-area-inset-bottom));
  background: #fff;
  color: #222625;
  letter-spacing: 0;
}
.detail-navigation {
  padding-left: 38rpx;
  position: sticky;
  top: 0;
  z-index: 40;
  background: #fff;
}
.product-detail-skeleton,
.product-detail-error {
  min-height: 360rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  color: #666e68;
  font-size: 28rpx;
  background: #f4f6f4;
}
.product-detail-error__title {
  display: block;
  line-height: 1.6;
}
.product-detail-error__retry {
  background: #222625;
  color: #fff;
  border-radius: 6rpx;
  margin: 28rpx auto;
  font-size: 26rpx;
  min-height: 88rpx;
}
.product-media {
  position: relative;
  width: 100%;
  height: 615rpx;
  background: #f4f6f4;
  overflow: hidden;
}
.product-media__swiper,
.product-media__image,
.product-media__empty {
  width: 100%;
  height: 100%;
}
.product-media__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666e68;
}
.product-media__dots {
  position: absolute;
  right: 32rpx;
  bottom: 26rpx;
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 4rpx;
  font-size: 22rpx;
  color: #222625;
}
.product-section {
  margin: 0 42rpx;
  padding: 38rpx 0;
  border-bottom: 1rpx solid #e5e8e5;
}
.product-intro {
  padding-bottom: 32rpx;
}
.product-brand {
  display: block;
  font-size: 22rpx;
  color: #43715b;
  margin-bottom: 18rpx;
}
.product-name {
  display: block;
  font-size: 40rpx;
  line-height: 1.4;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.product-support {
  display: block;
  font-size: 25rpx;
  color: #666e68;
  line-height: 1.6;
  margin-top: 12rpx;
}
.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 36rpx;
}
.price-row__price {
  font-size: 52rpx;
  font-weight: 600;
}
.price-row__unit {
  font-size: 22rpx;
  color: #666e68;
  margin-left: 8rpx;
}
.price-note {
  font-size: 21rpx;
  color: #666e68;
}
.price-support {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  color: #666e68;
  font-size: 22rpx;
  margin-top: 10rpx;
}
.product-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  margin-top: 28rpx;
  color: #43715b;
  font-size: 21rpx;
  line-height: 1.6;
}
.section-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  margin-bottom: 26rpx;
}
.sku-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}
.sku-item {
  position: relative;
  width: 100%;
  min-width: 0;
  min-height: 138rpx;
  margin: 0;
  text-align: left;
  padding: 24rpx 18rpx;
  border: 1rpx solid #dce2dc;
  border-radius: 6rpx;
  background: #fff;
  color: #222625;
  line-height: 1.5;
}
.sku-item.active {
  border-color: #43715b;
  background: #f4f7f4;
}
.sku-item[disabled] {
  background: #f4f6f4;
  color: #949b96;
}
.sku-item__name {
  display: block;
  font-size: 24rpx;
  padding-right: 10rpx;
  overflow-wrap: anywhere;
}
.sku-item__desc {
  display: block;
  font-size: 21rpx;
  color: #666e68;
  margin-top: 10rpx;
}
.sku-item__check {
  position: absolute;
  right: 12rpx;
  bottom: 8rpx;
  color: #43715b;
  font-size: 20rpx;
}
.quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 36rpx;
}
.quantity-title {
  font-size: 26rpx;
  font-weight: 600;
}
.quantity-unit {
  font-size: 22rpx;
  color: #666e68;
  margin-left: 12rpx;
}
button.buy-now[size="mini"] {
  margin: 14rpx 0 0 auto;
  padding: 0;
  width: 170rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  background: none;
  border-radius: 0;
  font-size: 24rpx;
  color: #43715b;
}
button.buy-now[size="mini"][disabled] {
  background: none;
  color: #949b96;
}
.inline-error {
  display: block;
  color: #b43d27;
  font-size: 24rpx;
  margin-top: 18rpx;
}
.param-item {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  font-size: 24rpx;
  line-height: 1.5;
  border-top: 1rpx solid #e5e8e5;
}
.param-item:first-child {
  border-top: 0;
}
.param-item__label {
  color: #666e68;
  flex-shrink: 0;
}
.param-item__value {
  text-align: right;
  overflow-wrap: anywhere;
}
.product-desc {
  font-size: 25rpx;
  line-height: 1.8;
  color: #666e68;
  white-space: pre-wrap;
}
.product-actionbar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 38rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5e8e5;
  background: #fff;
}
.product-actionbar__cart {
  position: relative;
  width: 64rpx;
  min-width: 64rpx;
  height: 88rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  background: none;
  border-radius: 0;
}
.product-actionbar__cart image {
  width: 38rpx;
  height: 38rpx;
}
.product-actionbar__badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #c4461b;
  color: white;
  font-size: 18rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 50%;
  text-align: center;
}
.product-actionbar__total {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: #666e68;
}
.product-actionbar__total > text {
  display: block;
}
.product-actionbar__amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #222625;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}
button.product-actionbar__primary[size="mini"] {
  width: 248rpx;
  flex: 0 0 248rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  min-height: 90rpx;
  margin: 0;
  padding: 12rpx 20rpx;
  border-radius: 6rpx;
  background: #222625;
  color: #fff;
  font-size: 25rpx;
  line-height: 1.5;
  flex-shrink: 0;
}
.product-actionbar__primary > text {
  font-size: 32rpx;
}
button.product-actionbar__primary[size="mini"][disabled] {
  background: #ebeeeb;
  color: #7f8781;
}
