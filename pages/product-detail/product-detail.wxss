.product-detail-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(196rpx + env(safe-area-inset-bottom));
  background: var(--brand-soft-gradient);
}

.product-detail-skeleton,
.product-detail-error {
  min-height: 60vh;
  padding: 36rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: var(--shadow-lg);
}

.product-detail-error {
  min-height: auto;
}

.product-detail-error__title {
  display: block;
  font-size: 31rpx;
  line-height: 1.55;
  color: var(--text-primary);
}

.product-detail-error__retry {
  min-height: 88rpx;
  margin-top: 26rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--brand-accent), var(--brand-primary));
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 700;
}

.product-detail-body {
  background: transparent;
}

.product-media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 0.9;
  overflow: hidden;
  border: 8rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 44rpx;
  background: #FFFFFF;
  box-shadow: var(--shadow-lg);
}

.product-media__swiper,
.product-media__image,
.product-media__empty {
  width: 100%;
  height: 100%;
}

.product-media__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #FFF6F2, #F4DDD7);
}

.product-media__empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.product-media__dots {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  background: rgba(102, 10, 10, 0.72);
  color: #FFFFFF;
  font-size: 23rpx;
}

.product-section {
  margin-top: 18rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: var(--shadow-md);
}

.product-name {
  display: block;
  font-size: 42rpx;
  line-height: 1.35;
  font-weight: 800;
  color: var(--text-primary);
}

.product-brand {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.price-row__price {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  color: var(--brand-primary);
}

.price-row__unit {
  font-size: 25rpx;
  color: var(--text-secondary);
}

.product-support,
.product-desc,
.inline-error {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.inline-error {
  color: var(--status-danger);
}

.product-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 0;
}

.product-meta text {
  padding: 10rpx 16rpx;
  border-radius: var(--radius-full);
  background: #FFF1EF;
  color: var(--brand-primary);
  font-size: 23rpx;
}

.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 750;
  color: var(--text-primary);
}

.sku-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.sku-item {
  min-width: 200rpx;
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--border-default);
  border-radius: 22rpx;
  background: #FFF9F7;
}

.sku-item.active {
  border-color: var(--brand-primary);
  background: #FFF0ED;
  box-shadow: 0 8rpx 20rpx rgba(141, 28, 28, 0.1);
}

.sku-item.disabled {
  opacity: 0.45;
}

.sku-item__name,
.sku-item__desc {
  display: block;
  font-size: 25rpx;
  line-height: 1.5;
  color: var(--text-primary);
}

.sku-item__desc {
  color: var(--text-secondary);
}

.param-list {
  display: flex;
  flex-direction: column;
}

.param-item {
  display: flex;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 68rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--border-subtle);
}

.param-item:first-child {
  border-top: 0;
}

.param-item__label,
.param-item__value {
  font-size: 25rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.param-item__value {
  color: var(--text-primary);
  text-align: right;
}

.product-actionbar {
  position: fixed;
  z-index: 20;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 12rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(141, 28, 28, 0.08);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: var(--shadow-lg);
}

.product-actionbar__cart,
.product-actionbar__secondary,
.product-actionbar__primary {
  min-height: 86rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.product-actionbar__cart {
  width: 142rpx;
  flex-shrink: 0;
  background: #F7E9E6;
  color: var(--brand-primary);
}

.product-actionbar__secondary {
  flex: 1;
  border: 2rpx solid var(--brand-primary);
  background: #FFFFFF;
  color: var(--brand-primary);
}

.product-actionbar__primary {
  flex: 1;
  background: linear-gradient(135deg, var(--brand-accent), var(--brand-primary));
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(141, 28, 28, 0.22);
}

.disabled {
  opacity: 0.5;
}

.product-actionbar__badge {
  min-width: 36rpx;
  height: 36rpx;
  margin-left: 6rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-full);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-primary);
  color: #FFFFFF;
  font-size: 21rpx;
}
