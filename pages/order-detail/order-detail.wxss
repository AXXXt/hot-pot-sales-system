.order-detail-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--brand-soft-gradient);
}

.od-loading,
.od-error {
  padding: 90rpx 32rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  color: var(--text-secondary);
  font-size: 28rpx;
  text-align: center;
  box-shadow: none;
}

.od-body {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.od-header {
  position: relative;
  overflow: hidden;
  padding: 20rpx 0 32rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 9rpx;
  background: #FFFFFF;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--border-default);
  box-shadow: none;
}

.od-header__status,
.od-header__no,
.od-header__time {
  position: relative;
  z-index: 1;
}

.od-header__status {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.od-header__status--success,
.od-header__status--warning,
.od-header__status--primary,
.od-header__status--info {
  color: var(--brand-secondary);
}

.od-header__no,
.od-header__time {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.od-card {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-default);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: none;
}

.od-card__title {
  display: block;
  margin-bottom: 18rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.od-card__text {
  display: block;
  color: var(--text-primary);
  font-size: 26rpx;
  line-height: 1.65;
}

.od-card__sub {
  display: block;
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.od-price-record + .od-price-record {
  margin-top: 20rpx;
}

.od-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 70rpx;
  padding: 12rpx 0;
}

.od-item + .od-item {
  border-top: 1rpx dashed var(--border-default);
}

.od-item__left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.od-item__name {
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 600;
}

.od-item__spec,
.od-item__qty,
.od-item__label {
  color: var(--text-secondary);
  font-size: 23rpx;
}

.od-item__right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.od-item__price {
  min-width: 120rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
}

.od-item__total {
  color: var(--brand-primary);
  font-size: 36rpx;
  font-weight: 600;
}

.od-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 4rpx;
}

.od-btn {
  min-height: 92rpx;
  border: 1rpx solid var(--border-default);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.94);
  color: var(--text-primary);
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: none;
}

.od-btn--primary {
  border-color: transparent;
  background: #222625;
  color: #FFFFFF;
  box-shadow: none;
}

.od-btn--danger {
  color: var(--status-danger);
}
button.od-btn { width: 100%; margin: 0; padding: 0 24rpx; }
button.od-btn::after { border: 0; }
button.od-btn[disabled] { background: #222625; color: #fff; opacity: 0.5; }
