.category-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg-canvas);
}

.category-header {
  position: relative;
  overflow: hidden;
  padding: 32rpx 32rpx 20rpx;
  background: #FFFFFF;
}

.category-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.category-topbar {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin: 0 32rpx 24rpx;
}

.category-toolbar {
  padding: 8rpx 4rpx;
}

.category-toolbar__scroll {
  width: 100%;
}

.category-toolbar__track {
  display: inline-flex;
  gap: 14rpx;
  min-width: 100%;
}

.category-toolbar__item {
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(34, 38, 37, 0.08);
  border-radius: 8rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.88);
  color: var(--text-secondary);
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: none;
}

.category-toolbar__item.active {
  border-color: var(--brand-secondary);
  background: #F1F5F2;
  color: var(--brand-secondary);
  box-shadow: none;
}

.category-content {
  margin-left: 32rpx;
  margin-right: 32rpx;
}

.category-filter {
  width: 100%;
  padding: 2rpx 4rpx 0;
}

.category-content {
  padding-top: 4rpx;
}
