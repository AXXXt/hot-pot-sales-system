.category-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg-canvas);
}

.category-header {
  position: relative;
  overflow: hidden;
  min-height: 240rpx;
  padding: 54rpx 32rpx 120rpx;
  background: var(--brand-gradient);
}

.category-header::after {
  content: '';
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  right: -210rpx;
  top: -210rpx;
  border: 7rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

.category-title {
  position: relative;
  z-index: 1;
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.category-topbar {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin: -82rpx 32rpx 24rpx;
}

.category-toolbar {
  padding: 8rpx 4rpx;
}

.category-toolbar__scroll {
  width: 100%;
}

.category-toolbar__track {
  display: inline-flex;
  gap: 14rpx;
  min-width: 100%;
}

.category-toolbar__item {
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(141, 28, 28, 0.08);
  border-radius: var(--radius-full);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.88);
  color: var(--text-secondary);
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

.category-toolbar__item.active {
  border-color: transparent;
  background: linear-gradient(135deg, var(--brand-accent), var(--brand-primary));
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(141, 28, 28, 0.2);
}

.category-content {
  margin-left: 32rpx;
  margin-right: 32rpx;
}

.category-filter {
  width: 100%;
  padding: 2rpx 4rpx 0;
}

.category-content {
  padding-top: 4rpx;
}
