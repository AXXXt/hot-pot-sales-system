# 统一换行符策略：文本文件以 LF 存储；仅 Windows 批处理保持 CRLF
* text=auto

# ---- 代码/配置文本：强制 LF ----
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.vue      text eol=lf
*.wxml     text eol=lf
*.wxss     text eol=lf
*.html     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.prisma   text eol=lf
*.sql      text eol=lf
*.toml     text eol=lf
*.env.example text eol=lf

# ---- Windows 批处理：保持 CRLF（cmd 兼容性） ----
*.cmd      text eol=crlf
*.bat      text eol=crlf

# ---- 锁文件 ----
package-lock.json text eol=lf

# ---- 二进制文件（不进行换行/文本转换） ----
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary