model StockAdjustment {
  id           Int             @id @default(autoincrement())
  tenantId     Int             @map("tenant_id")
  adjustmentNo String          @unique @map("adjustment_no") @db.VarChar(64)
  type         String          @db.VarChar(32)
  reason       String?         @db.VarChar(255)
  operatorId   Int?            @map("operator_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  operator     User?           @relation("StockAdjustmentOperator", fields: [operatorId], references: [id])
  movements    StockMovement[]

  @@index([tenantId, createdAt])
  @@map("stock_adjustments")
}

model Stocktake {
  id          Int             @id @default(autoincrement())
  tenantId    Int             @map("tenant_id")
  stocktakeNo String          @unique @map("stocktake_no") @db.VarChar(64)
  status      String          @default("draft") @db.VarChar(32)
  remark      String?         @db.VarChar(255)
  operatorId  Int?            @map("operator_id")
  reviewedBy  Int?            @map("reviewed_by")
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  operator    User?           @relation("StocktakeOperator", fields: [operatorId], references: [id])
  reviewer    User?           @relation("StocktakeReviewer", fields: [reviewedBy], references: [id])
  items       StocktakeItem[]

  @@index([tenantId, status, createdAt])
  @@map("stocktakes")
}

model StocktakeItem {
  receiptBatch Json? @map("receipt_batch")
  id          Int        @id @default(autoincrement())
  tenantId    Int        @map("tenant_id")
  stocktakeId Int        @map("stocktake_id")
  skuId       Int        @map("sku_id")
  systemQty   Int        @map("system_qty")
  countedQty  Int?       @map("counted_qty")
  diffQty     Int        @default(0) @map("diff_qty")
  remark      String?    @db.VarChar(255)
  sku         ProductSku @relation(fields: [skuId], references: [id])
  stocktake   Stocktake  @relation(fields: [stocktakeId], references: [id])
  tenant      Tenant     @relation(fields: [tenantId], references: [id])

  @@unique([stocktakeId, skuId])
  @@index([tenantId, skuId])
  @@map("stocktake_items")
}

enum LeadSource {
  official_site
  phone
  manual
}

model Lead {
  id               Int         @id @default(autoincrement())
  tenantId         Int         @map("tenant_id")
  phone            String      @db.VarChar(20)
  name             String?     @db.VarChar(100)
  storeName        String?     @map("store_name") @db.VarChar(120)
  storeScale       String?     @map("store_scale") @db.VarChar(32)
  interestedItems  String?     @map("interested_items") @db.VarChar(500)
  remark           String?     @db.VarChar(500)
  source           LeadSource  @default(official_site)
  status           LeadStatus  @default(new)
  assignedToId     Int?        @map("assigned_to_id")
  customerId       Int?        @map("customer_id")
  submissionKey    String?     @unique @map("submission_key") @db.Char(64)
  submissionDigest String?     @map("submission_digest") @db.Char(64)
  nextFollowUpAt   DateTime?   @map("next_follow_up_at")
  lastContactAt    DateTime?   @map("last_contact_at")
  ipAddress        String?     @map("ip_address") @db.VarChar(64)
  userAgent        String?     @map("user_agent") @db.VarChar(255)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  assignedTo       User?       @relation("LeadAssignee", fields: [assignedToId], references: [id])
  followUps        LeadFollowUp[]
  submissions      LeadSubmission[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, phone])
  @@index([tenantId, customerId])
  @@map("leads")
}

model LeadFollowUp {
  id             Int        @id @default(autoincrement())
  leadId         Int        @map("lead_id")
  operatorId     Int?       @map("operator_id")
  content        String     @db.VarChar(500)
  nextFollowUpAt DateTime?  @map("next_follow_up_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  lead           Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  operator       User?      @relation(fields: [operatorId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_follow_ups")
}

// AI conversations and actions are always scoped by the authenticated tenant and owner.
model AiConfig {
  tenantId       Int      @id @map("tenant_id")
  enabled        Boolean  @default(false)
  baseUrl        String   @default("") @map("base_url") @db.VarChar(500)
  textModel      String   @default("") @map("text_model") @db.VarChar(100)
  visionModel    String   @default("") @map("vision_model") @db.VarChar(100)
  encryptedKey   String?  @map("encrypted_key") @db.Text
  allowWrites    Boolean  @default(false) @map("allow_writes")
  dailyRequests  Int      @default(100) @map("daily_requests")
  features       Json
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ai_configs")
}

model AiConversation {
  id          String          @id @default(uuid()) @db.VarChar(36)
  tenantId    Int             @map("tenant_id")
  ownerId     Int             @map("owner_id")
  title       String          @db.VarChar(100)
  fingerprint String          @db.VarChar(64)
  archived    Boolean         @default(false)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  messages    AiMessage[]
  drafts      AiActionDraft[]

  @@unique([tenantId, ownerId, id])
  @@index([tenantId, ownerId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid()) @db.VarChar(36)
  tenantId       Int            @map("tenant_id")
  ownerId        Int            @map("owner_id")
  conversationId String         @map("conversation_id") @db.VarChar(36)
  role           String         @db.VarChar(20)
  content        String         @db.MediumText
  cards          Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   AiConversation @relation(fields: [tenantId, ownerId, conversationId], references: [tenantId, ownerId, id], onDelete: Restrict)

  @@index([tenantId, ownerId, conversationId, createdAt])
  @@map("ai_messages")
}

model AiAttachment {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    Int      @map("tenant_id")
  ownerId     Int      @map("owner_id")
  objectKey   String   @map("object_key") @db.VarChar(500)
  mimeType    String   @map("mime_type") @db.VarChar(100)
  fileSize    Int      @map("file_size")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, ownerId, expiresAt])
  @@map("ai_attachments")
}

model AiActionDraft {
  id             String            @id @default(uuid()) @db.VarChar(36)
  tenantId       Int               @map("tenant_id")
  ownerId        Int               @map("owner_id")
  conversationId String            @map("conversation_id") @db.VarChar(36)
  action         String            @db.VarChar(50)
  payload        Json
  fingerprint    String            @db.VarChar(64)
  version        Int               @default(1)
  digest         String            @db.VarChar(64)
  status         String            @default("draft") @db.VarChar(32)
  expiresAt      DateTime          @map("expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  conversation   AiConversation    @relation(fields: [tenantId, ownerId, conversationId], references: [tenantId, ownerId, id], onDelete: Restrict)
  execution      AiActionExecution?

  @@unique([tenantId, ownerId, id])
  @@index([tenantId, ownerId, status])
  @@map("ai_action_drafts")
}

model AiActionExecution {
  id          String        @id @default(uuid()) @db.VarChar(36)
  tenantId    Int           @map("tenant_id")
  ownerId     Int           @map("owner_id")
  draftId     String        @unique @map("draft_id") @db.VarChar(36)
  action      String        @db.VarChar(50)
  result      Json
  createdAt   DateTime      @default(now()) @map("created_at")
  draft       AiActionDraft @relation(fields: [tenantId, ownerId, draftId], references: [tenantId, ownerId, id], onDelete: Restrict)

  @@unique([tenantId, ownerId, draftId])
  @@index([tenantId, ownerId, createdAt])
  @@map("ai_action_executions")
}

model AiUsageRecord {
  id           String   @id @default(uuid()) @db.VarChar(36)
  tenantId     Int      @map("tenant_id")
  ownerId      Int      @map("owner_id")
  model        String   @db.VarChar(100)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  images       Int      @default(0)
  status       String   @default("reserved") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, ownerId, createdAt])
  @@map("ai_usage_records")
}

model OpsTask {
  id              String   @id @default(uuid()) @db.VarChar(36)
  tenantId        Int      @map("tenant_id")
  ownerId         Int      @map("owner_id")
  title           String   @db.VarChar(200)
  dueAt           DateTime @map("due_at")
  status          String   @default("pending") @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenantId, ownerId, status, dueAt])
  @@map("ops_tasks")
}

model StockBatch {
  id             Int        @id @default(autoincrement())
  tenantId       Int        @map("tenant_id")
  skuId          Int        @map("sku_id")
  batchNo        String     @map("batch_no") @db.VarChar(64)
  productionDate DateTime?  @map("production_date") @db.Date
  expiryDate     DateTime?  @map("expiry_date") @db.Date
  quantity       Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at")
  sku            ProductSku @relation(fields: [skuId], references: [id])

  @@unique([tenantId, skuId, batchNo])
  @@index([tenantId, expiryDate])
  @@map("stock_batches")
}

model ReplenishmentPlan {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  ownerId   Int      @map("owner_id")
  planNo    String   @unique @map("plan_no") @db.VarChar(64)
  status    String   @default("draft") @db.VarChar(32)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, ownerId, status])
  @@map("replenishment_plans")
}

model AiSchedule {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    Int      @map("tenant_id")
  ownerId     Int      @map("owner_id")
  name        String   @db.VarChar(100)
  kind        String   @db.VarChar(32)
  hour        Int      @default(9)
  weekday     Int?      @map("weekday")
  enabled     Boolean  @default(true)
  fingerprint String   @db.VarChar(64)
  nextRunAt   DateTime @map("next_run_at")
  lastRunAt   DateTime? @map("last_run_at")
  lastResult  Json?    @map("last_result")
  error       String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([enabled, nextRunAt])
  @@index([tenantId, ownerId])
  @@map("ai_schedules")
}

model LegalConsent {
  id           Int      @id @default(autoincrement())
  tenantId     Int?     @map("tenant_id")
  userId       Int?     @map("user_id")
  leadId       Int?     @unique @map("lead_id")
  version      String   @db.VarChar(64)
  documentHash String   @map("document_hash") @db.Char(64)
  channel      String   @db.VarChar(32)
  acceptedAt   DateTime @default(now()) @map("accepted_at")

  @@unique([userId, version, channel])
  @@index([tenantId, userId])
  @@map("legal_consents")
}

model ServiceRequest {
  id           Int       @id @default(autoincrement())
  tenantId     Int       @map("tenant_id")
  customerId   Int       @map("customer_id")
  requesterId  Int       @map("requester_id")
  orderId      Int?      @map("order_id")
  processorId  Int?      @map("processor_id")
  requestNo    String    @unique @map("request_no") @db.VarChar(40)
  clientKey    String    @map("client_key") @db.VarChar(64)
  type         String    @db.VarChar(32)
  subject      String    @db.VarChar(120)
  description  String    @db.Text
  status       String    @default("pending") @db.VarChar(32)
  version      Int       @default(0)
  resolution   String?   @db.Text
  events       Json      @default("[]")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  closedAt     DateTime? @map("closed_at")
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  customer     Customer  @relation(fields: [customerId], references: [id])
  requester    User      @relation("ServiceRequester", fields: [requesterId], references: [id])
  processor    User?     @relation("ServiceProcessor", fields: [processorId], references: [id])
  order        Order?    @relation(fields: [orderId], references: [id])

  @@unique([tenantId, requesterId, clientKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId, requesterId])
  @@map("service_requests")
}

model LeadSubmission {
  key       String   @id @db.Char(64)
  digest    String   @db.Char(64)
  leadId    Int      @map("lead_id")
  tenantId  Int      @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
  @@map("lead_submissions")
}
