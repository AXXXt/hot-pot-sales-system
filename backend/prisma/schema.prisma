  tenantId   Int      @map("tenant_id")
  orderId    Int      @map("order_id")
  amount     Decimal  @db.Decimal(18, 2)
  method     String   @db.VarChar(32)
  reason     String?  @db.VarChar(255)
  operatorId Int?     @map("operator_id")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId, createdAt])
  @@map("order_refunds")
}

model StockMovement {
  id                Int              @id @default(autoincrement())
  tenantId          Int              @map("tenant_id")
  skuId             Int              @map("sku_id")
  productId         Int?             @map("product_id")
  changeQty         Int              @map("change_qty")
  beforeQty         Int              @map("before_qty")
  afterQty          Int              @map("after_qty")
  batchAllocations  Json?            @map("batch_allocations")
  type              String           @db.VarChar(32)
  sourceType        String           @map("source_type") @db.VarChar(32)
  sourceId          Int?             @map("source_id")
  operatorId        Int?             @map("operator_id")
  remark            String?          @db.VarChar(255)
  createdAt         DateTime         @default(now()) @map("created_at")
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  sku               ProductSku       @relation(fields: [skuId], references: [id])
  operator          User?            @relation("StockMovementOperator", fields: [operatorId], references: [id])
  stockAdjustment   StockAdjustment? @relation(fields: [stockAdjustmentId], references: [id])
  stockAdjustmentId Int?             @map("stock_adjustment_id")

  @@index([tenantId, skuId, createdAt])
  @@index([tenantId, sourceType, sourceId])
