# ========== 生产环境配置模板（复制为 .env 使用） ==========
NODE_ENV=production
PORT=3000

# MySQL（生产使用独立账号 + 强密码）
DATABASE_URL=mysql://b2b_user:CHANGE_ME_STRONG_PASSWORD@your-db-host:3306/b2b_miniapp

# Redis
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@your-redis-host:6379

# JWT 密钥（必须为强随机值，可用 openssl rand -hex 32 生成）
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET

# 短信服务商（必须为真实 provider，如 aliyun / tencentcloud）
SMS_PROVIDER=CHANGE_ME_REAL_PROVIDER

# MinIO / 对象存储（使用独立 Access Key，勿用 minioadmin）
MINIO_ENDPOINT=your-minio-host
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=b2b-miniapp
MINIO_PUBLIC_URL=https://cdn.your-domain.com
MINIO_USE_SSL=true

# 跨域白名单（逗号分隔，填写管理后台生产域名）
CORS_ORIGIN=https://admin.your-domain.com