NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://root:password@127.0.0.1:3307/b2b_miniapp
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
SMS_PROVIDER=development
SMS_DEV_CODE=123456
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_LOGIN_TEMPLATE_ID=
TENCENT_SMS_REGISTER_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=b2b-miniapp
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_USE_SSL=false
CORS_ORIGIN=http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5180

# 官网留资：官网通过 http(s) 部署时，把官网域名加入 CORS_ORIGIN（file:// 打开无需配置）

# AI密钥加密主密钥：32个随机字节的Base64；未配置时不能保存模型API Key。
# 使用 node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))" 生成，勿提交真实值。
AI_ENCRYPTION_KEY=

# 微信订阅消息：AppSecret仅填写在私有环境配置中；模板64645的字段固定见订阅消息文档。
WX_APPID=
WX_SECRET=
WX_SUBSCRIBE_TPL_ORDER=
WX_MINIPROGRAM_STATE=formal
# 从微信实际模板详情复制ID及字段映射；未配置时隐藏该提醒，不能复用发货模板。
WX_SUBSCRIBE_TPL_QUOTE=
WX_SUBSCRIBE_FIELDS_QUOTE=
WX_SUBSCRIBE_TPL_APPROVED=
WX_SUBSCRIBE_FIELDS_APPROVED=
