.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 8rpx;
}

.page-header__left,
.page-header__right {
  width: 96rpx;
  display: flex;
  align-items: center;
}

.page-header__center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page-header__title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.page-header__subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.page-header__back {
  font-size: 40rpx;
  color: var(--text-primary);
}

.page-header { padding-top: 28rpx; }
.page-header__title { color: var(--brand-deep); font-size: 36rpx; font-weight: 800; }
.page-header__back { color: var(--brand-primary); font-weight: 700; }
