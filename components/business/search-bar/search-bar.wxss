.search-bar {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(60, 60, 67, 0.18);
}

.search-bar__icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  position: relative;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  color: var(--text-secondary);
}

.search-bar__icon-handle {
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 8rpx;
  background: currentColor;
  transform: rotate(45deg);
  transform-origin: center;
}

.search-bar__input {
  flex: 1;
  font-size: 30rpx;
  line-height: 44rpx;
  color: var(--text-primary);
}

.search-bar {
  min-height: 96rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--border-default);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: none;
}

.search-bar__icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 20rpx;
  opacity: 0.58;
}
.search-bar__image { width: 36rpx; height: 36rpx; flex-shrink: 0; margin-right: 20rpx; }
.search-bar__input { min-width: 0; }
