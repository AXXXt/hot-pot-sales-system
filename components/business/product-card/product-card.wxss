.product-card {
  display: flex;
  overflow: hidden;
  padding: 18rpx;
  margin-top: 18rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  border-radius: 8rpx;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: var(--glass-backdrop);
}

.product-card__image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  background: #f4f6f4;
  flex-shrink: 0;
}

.product-card__body {
  flex: 1;
  padding-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.product-card__spec,
.product-card__stock {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.product-card__footer {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.product-card__price {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand-accent);
}

.product-card__action {
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(17, 24, 39, 0.04);
}

.product-card__action-text {
  font-size: 22rpx;
  color: var(--text-primary);
}

.product-card {
  border: 1rpx solid var(--border-subtle);
  border-radius: 8rpx;
  background: rgba(255,255,255,0.97);
  box-shadow: none;
  overflow: hidden;
}
.product-card__price { color: var(--brand-primary); }
.product-card__action {
  background: #222625;
  box-shadow: none;
}
.product-card__action-text { color: #fff; font-weight: 600; }
