.segmented-control,
.segmented-control__scroll {
  width: 100%;
}
.segmented-control__track {
  display: inline-flex;
  gap: 36rpx;
}
.segmented-control__item {
  flex-shrink: 0;
  min-height: 88rpx;
  padding: 0 0 8rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-bottom: 3rpx solid transparent;
  color: #666e68;
  font-size: 28rpx;
}
.segmented-control__item.active {
  border-bottom-color: #222625;
  color: #222625;
  font-weight: 600;
}
