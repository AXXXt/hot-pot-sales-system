.segmented-control { width: 100%; }
.segmented-control__scroll { width: 100%; }
.segmented-control__track { display: inline-flex; gap: 12rpx; padding: 4rpx 0; }
.segmented-control__item {
  flex-shrink: 0; height: 44rpx; padding: 0 28rpx; border-radius: var(--radius-full);
  display: inline-flex; align-items: center; justify-content: center;
  background: rgba(142,142,147,0.08);
  color: var(--text-secondary); font-size: 28rpx; font-weight: 500;
  transition: all 0.2s;
}
.segmented-control__item.active {
  background: var(--brand-primary); color: #fff; font-weight: 600;
}

.segmented-control__track { gap: 16rpx; padding: 6rpx 0; }
.segmented-control__item {
  height: 58rpx;
  padding: 0 30rpx;
  background: rgba(255,255,255,0.82);
  color: var(--text-secondary);
  border: 1rpx solid rgba(141,28,28,0.08);
  box-shadow: 0 6rpx 16rpx rgba(102,10,10,0.04);
}
.segmented-control__item.active {
  background: linear-gradient(135deg, var(--brand-accent), var(--brand-primary));
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(141,28,28,0.22);
}
