.quantity-stepper {
  display: inline-flex;
  align-items: center;
  border: 1rpx solid #dce2dc;
  border-radius: 6rpx;
  overflow: hidden;
  background: #fff;
}
.quantity-stepper__btn,
.quantity-stepper__value {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #222625;
  background: #fff;
  border-radius: 0;
  line-height: 1;
}
.quantity-stepper__btn[disabled] {
  color: #a7ada8;
}
.quantity-stepper__value {
  min-width: 72rpx;
  width: 72rpx;
  font-variant-numeric: tabular-nums;
}
