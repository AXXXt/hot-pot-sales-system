.quantity-stepper {
  display: inline-flex;
  align-items: center;
  border-radius: 20rpx;
  background: rgba(17, 24, 39, 0.04);
  overflow: hidden;
}

.quantity-stepper__btn,
.quantity-stepper__value {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.quantity-stepper__btn {
  color: var(--text-primary);
  font-weight: 600;
}

.quantity-stepper__value {
  min-width: 88rpx;
  background: #ffffff;
  color: var(--text-primary);
  border-left: 1rpx solid rgba(60, 60, 67, 0.18);
  border-right: 1rpx solid rgba(60, 60, 67, 0.18);
}

.quantity-stepper {
  border: 1rpx solid rgba(141,28,28,0.14);
  border-radius: 20rpx;
  background: #FFF5F4;
  overflow: hidden;
}
.quantity-stepper__btn { color: var(--brand-primary); font-weight: 800; }
.quantity-stepper__value {
  background: #FFE6E3;
  color: var(--brand-deep);
  border-color: rgba(141,28,28,0.10);
  font-weight: 700;
}
