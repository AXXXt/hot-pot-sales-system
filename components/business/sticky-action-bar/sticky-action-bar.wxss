.sticky-action-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  gap: 16rpx;
}

.sticky-action-bar__secondary,
.sticky-action-bar__primary {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.sticky-action-bar__secondary {
  background: var(--bg-subtle);
  color: var(--text-primary);
}

.sticky-action-bar__primary {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.sticky-action-bar {
  background: rgba(255,255,255,0.94);
  border-top: 1rpx solid rgba(34, 38, 37,0.08);
  box-shadow: none;
  backdrop-filter: none;
}
.sticky-action-bar__secondary,
.sticky-action-bar__primary { border-radius: 8rpx; }
.sticky-action-bar__secondary { background: #FFF2F0; color: var(--brand-primary); }
.sticky-action-bar__primary {
  background: #222625;
  box-shadow: none;
}
