.cart-sheet-root {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.cart-sheet-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(34, 38, 37, 0);
  transition: background 0.25s ease;
}

.cart-sheet-overlay.show {
  background: var(--bg-overlay);
}

.cart-sheet-panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 76vh;
  overflow: hidden;
  border-radius: 8rpx 8rpx 0 0;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  box-shadow: none;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
}

.cart-sheet-panel.show {
  transform: translateY(0);
}

.cart-sheet-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx 20rpx;
}

.cart-sheet-title {
  color: var(--text-primary);
  font-size: 36rpx;
  font-weight: 600;
}

.cart-sheet-close {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f6f4;
  color: var(--brand-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.cart-sheet-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx 82rpx;
}

.cart-sheet-empty__icon {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 18rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f6f4;
  font-size: 54rpx;
}

.cart-sheet-empty__text {
  margin-bottom: 24rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.cart-sheet-empty__btn {
  min-width: 190rpx;
  min-height: 82rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-primary);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
}

.cart-sheet-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx;
}

.cart-sheet-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-subtle);
  border-radius: 8rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.cart-sheet-item.is-unavailable {
  opacity: 0.58;
}

.cart-sheet-item__info {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  margin-bottom: 14rpx;
}

.cart-sheet-item__name {
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 600;
}

.cart-sheet-item__spec,
.cart-sheet-item__price {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.cart-sheet-item__error,
.cart-sheet-item__remove {
  color: var(--status-danger);
  font-size: 22rpx;
}

.cart-sheet-item__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cart-sheet-item__qty {
  overflow: hidden;
  border: 1rpx solid var(--border-default);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  background: #f4f6f4;
}

.cs-qty-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-primary);
  font-size: 31rpx;
  font-weight: 600;
}

.cs-qty-val {
  min-width: 60rpx;
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.cart-sheet-item__amount {
  color: var(--brand-primary);
  font-size: 31rpx;
  font-weight: 600;
}

.cart-sheet-item__remove {
  min-height: 56rpx;
  display: flex;
  align-items: center;
}

.cart-sheet-footer {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border-subtle);
  background: rgba(255, 255, 255, 0.96);
}

.cart-sheet-footer__total {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.cart-sheet-footer__label {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.cart-sheet-footer__amount {
  color: var(--brand-primary);
  font-size: 36rpx;
  font-weight: 600;
}

.cart-sheet-footer__btn {
  min-width: 230rpx;
  min-height: 88rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #222625;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: none;
}

.cart-sheet-footer__btn.disabled {
  background: #d5dbd6;
  box-shadow: none;
}

.cart-sheet-validation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx;
  background: #f4f6f4;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}
.cart-sheet-validation.is-error { color: var(--status-danger); }
.cart-sheet-validation__retry {
  flex-shrink: 0;
  margin: 0;
  background: #FFFFFF;
  color: var(--brand-primary);
  font-size: 23rpx;
}
.cs-qty-btn.is-disabled { color: var(--text-secondary); opacity: 0.45; }
