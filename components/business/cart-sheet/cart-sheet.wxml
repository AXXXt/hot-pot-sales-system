<view wx:if="{{visible}}" class="cart-sheet-root">
  <view class="cart-sheet-overlay {{animating ? 'show' : ''}}" bindtap="onOverlayTap"></view>
  <view class="cart-sheet-panel {{animating ? 'show' : ''}}" catchtap="preventBubble">
    <!-- Header -->
    <view class="cart-sheet-header">
      <text class="cart-sheet-title">购物车</text>
      <view class="cart-sheet-close" role="button" aria-label="关闭购物车" bindtap="onClose">×</view>
    </view>

    <!-- Empty -->
    <view wx:if="{{isEmpty}}" class="cart-sheet-empty">
      <image class="cart-sheet-empty__icon" src="/assets/brand/cart.png" mode="aspectFit" aria-hidden="true" />
      <text class="cart-sheet-empty__text">购物车是空的</text>
      <view class="cart-sheet-empty__btn" bindtap="onGoShop">去逛逛</view>
    </view>

    <!-- Items -->
    <view wx:else class="cart-sheet-body">
      <!-- 校验失败持续阻断结算，数量错误保留调整入口。 -->
      <view wx:if="{{validationLoading}}" class="cart-sheet-validation">正在核对库存与起订量…</view>
      <view wx:elif="{{loggedIn && (validationError || needsValidation)}}" class="cart-sheet-validation is-error">
        <text>{{validationError || '进货单已更新，请重新校验商品信息'}}</text>
        <button size="mini" class="cart-sheet-validation__retry" bindtap="onRetryValidation">重新校验</button>
      </view>
      <view wx:for="{{items}}" wx:key="skuId" class="cart-sheet-item {{item.available || item.canAdjust ? '' : 'is-unavailable'}}">
        <view class="cart-sheet-item__info">
          <text class="cart-sheet-item__name">{{item.name}}</text>
          <text class="cart-sheet-item__spec" wx:if="{{item.spec}}">{{item.spec}}</text>
          <text class="cart-sheet-item__price">¥{{item.priceText}} / {{item.unit}}</text>
          <text class="cart-sheet-item__spec" wx:if="{{item.boundsKnown}}">{{item.minOrderQty}}{{item.unit}}起订 · 可用库存{{item.stockNum}}{{item.unit}}</text>
          <text class="cart-sheet-item__spec" wx:if="{{!item.canAdjust}}">已选{{item.quantityText}}{{item.unit}}</text>
          <text class="cart-sheet-item__error" wx:if="{{!item.available}}">{{item.unavailableReason}}</text>
        </view>
        <view class="cart-sheet-item__actions">
          <view wx:if="{{item.canAdjust}}" class="cart-sheet-item__qty">
            <view class="cs-qty-btn {{validationLoading ? 'is-disabled' : ''}}" data-index="{{index}}" bindtap="onDecrease">-</view>
            <text class="cs-qty-val">{{item.quantityText}}</text>
            <view class="cs-qty-btn {{validationLoading || item.quantity >= item.stockNum ? 'is-disabled' : ''}}" data-index="{{index}}" bindtap="onIncrease">+</view>
          </view>
          <view class="cart-sheet-item__remove" data-index="{{index}}" bindtap="onRemove">移除</view>
          <text wx:if="{{item.canAdjust}}" class="cart-sheet-item__amount">¥{{item.amount}}</text>
        </view>
      </view>
    </view>

    <!-- Footer -->
    <view wx:if="{{!isEmpty}}" class="cart-sheet-footer">
      <view class="cart-sheet-footer__total">
        <text class="cart-sheet-footer__label">合计</text>
        <text class="cart-sheet-footer__amount">¥{{totalAmount}}</text>
      </view>
      <view class="cart-sheet-footer__btn {{loggedIn && checkoutDisabled ? 'disabled' : ''}}" bindtap="onCheckout">
        {{!loggedIn ? '登录后结算' : validationLoading ? '校验中…' : '去结算'}}
      </view>
    </view>
  </view>
</view>
