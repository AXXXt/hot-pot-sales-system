.pr {
  display: flex; align-items: flex-start; gap: 20rpx;
  padding: 28rpx; margin-bottom: 16rpx;
  background: var(--glass-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.pr__img-wrap { position: relative; width: 136rpx; height: 136rpx; flex-shrink: 0; border-radius: var(--radius-md); overflow: hidden; background: #F8EFED; }
.pr__img { width: 100%; height: 100%; }
.pr__img--empty { opacity: 0; }
.pr__img-placeholder {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #FFF8F6 25%, #F2DAD5 50%, #FFF8F6 75%);
  background-size: 200% 100%; animation: pr-shimmer 1.6s infinite;
}
.pr__img-placeholder-icon { font-size: 36rpx; color: #C7C7CC; font-weight: 700; }
@keyframes pr-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

.pr__body { flex: 1; min-width: 0; }
.pr__top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 8rpx; }
.pr__name { font-size: 30rpx; font-weight: 650; color: var(--text-primary); line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pr__badge {
  flex-shrink: 0; font-size: 20rpx; font-weight: 600; padding: 4rpx 12rpx; border-radius: var(--radius-full); line-height: 1.4;
}
.pr__badge--default  { background: rgba(142,142,147,0.10); color: var(--text-secondary); }
.pr__badge--success  { background: rgba(52,199,89,0.10); color: var(--status-success); }
.pr__badge--warning  { background: rgba(255,159,10,0.10); color: var(--status-warning); }
.pr__badge--danger   { background: rgba(255,59,48,0.10); color: var(--status-danger); }
.pr__badge--brand    { background: rgba(255,122,0,0.08); color: var(--brand-primary); }

.pr__spec { display: block; font-size: 26rpx; color: var(--text-secondary); line-height: 1.5; margin-bottom: 10rpx; }

.pr__bottom { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.pr__price-row { display: flex; align-items: baseline; gap: 0; }
.pr__price { font-size: 34rpx; font-weight: 700; color: var(--text-primary); line-height: 1.3; }
.pr__unit  { font-size: 24rpx; color: var(--text-secondary); }
.pr__sub   { font-size: 24rpx; color: var(--text-tertiary); text-align: right; }

.pr__add {
  width: 56rpx; height: 56rpx; flex-shrink: 0; align-self: center;
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 500; color: #fff;
  background: var(--brand-primary);
}

.pr {
  position: relative;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 22rpx;
  background: rgba(255,255,255,0.97);
  border: 1rpx solid var(--border-subtle);
  border-radius: 34rpx;
  box-shadow: var(--shadow-md);
}
.pr__img-wrap { width: 148rpx; height: 148rpx; border-radius: 28rpx; background: #F8EFED; }
.pr__name { font-size: 31rpx; color: #222; }
.pr__price { color: var(--brand-primary); }
.pr__add {
  width: 60rpx;
  height: 60rpx;
  border-radius: 22rpx 0 22rpx 0;
  background: linear-gradient(135deg, var(--brand-primary), var(--brand-deep));
  box-shadow: 0 10rpx 22rpx rgba(102,10,10,0.20);
}
.pr__badge--brand { background: rgba(141,28,28,0.09); color: var(--brand-primary); }
