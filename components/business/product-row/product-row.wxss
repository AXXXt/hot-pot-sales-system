.pr {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #e5e8e5;
  background: #fff;
  letter-spacing: 0;
}
.pr__img-wrap {
  position: relative;
  width: 176rpx;
  height: 194rpx;
  flex-shrink: 0;
  background: #f4f6f4;
  overflow: hidden;
}
.pr__img {
  width: 100%;
  height: 100%;
}
.pr__img--empty {
  opacity: 0;
}
.pr__img-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f6f4;
}
.pr__img-placeholder-icon {
  font-size: 22rpx;
  color: #666e68;
}
.pr__body {
  flex: 1;
  min-width: 0;
}
.pr__top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.pr__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222625;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.pr__badge {
  font-size: 18rpx;
  padding: 2rpx 6rpx;
  border: 1rpx solid #e5e8e5;
  color: #666e68;
  line-height: 1.4;
}
.pr__badge--success,
.pr__badge--brand {
  color: #43715b;
}
.pr__badge--danger {
  color: #b43d27;
}
.pr__badge--warning {
  color: #956224;
}
.pr__spec {
  display: block;
  font-size: 22rpx;
  color: #666e68;
  line-height: 1.6;
  margin-bottom: 16rpx;
  overflow-wrap: anywhere;
}
.pr__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  min-height: 88rpx;
}
.pr__price-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}
.pr__currency {
  font-size: 22rpx;
}
.pr__price {
  font-size: 34rpx;
  font-weight: 600;
  color: #222625;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.pr__unit {
  font-size: 21rpx;
  color: #666e68;
}
.pr__sub {
  display: block;
  font-size: 20rpx;
  color: #666e68;
  margin-top: 4rpx;
}
button.pr__add[size="mini"] {
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  border: 1rpx solid #dce2dc;
  border-radius: 50%;
  background: #fff;
  color: #222625;
  font-size: 38rpx;
  font-weight: 400;
  text-align: center;
}
.pr__add:active {
  background: #f4f6f4;
}
.pr__add::after {
  border: 0;
}
