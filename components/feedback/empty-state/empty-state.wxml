<view class="empty-state card">
  <image class="empty-state__icon" src="/assets/brand/orders.png" mode="aspectFit" aria-hidden="true" />
  <text class="empty-state__title">{{title}}</text>
  <text class="empty-state__desc">{{desc}}</text>
  <view wx:if="{{actionText}}" class="empty-state__action" bindtap="onActionTap">{{actionText}}</view>
</view>
