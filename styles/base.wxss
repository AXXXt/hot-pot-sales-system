.page {
  min-height: 100vh;
  padding: 0;
  background: var(--bg-canvas);
}

.container {
  padding: var(--space-4);
}

.card {
  background: var(--bg-surface);
  border: 0;
  border-radius: var(--radius-xl);
  box-shadow: none;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-primary);
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.muted {
  color: var(--text-tertiary);
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.row {
  display: flex;
  flex-direction: row;
}

.column {
  display: flex;
  flex-direction: column;
}

.brand-page {
  min-height: 100vh;
  background: var(--bg-canvas);
}

.brand-hero {
  position: relative;
  overflow: hidden;
  background: var(--brand-gradient);
  color: var(--text-inverse);
}

.brand-panel {
  background: var(--bg-surface);
  border: 0;
  border-radius: var(--radius-xl);
  box-shadow: none;
}

.pressable {
  transition: transform var(--motion-fast) ease, opacity var(--motion-fast) ease;
}

.pressable:active {
  transform: scale(0.98);
  opacity: 0.92;
}
