page,
.page {
  --brand-primary: #222625;
  --brand-deep: #151916;
  --brand-accent: #C4461B;
  --brand-secondary: #43715B;
  --brand-muted: #666E68;
  --brand-surface-pink: #F4F6F4;
  --brand-surface-warm: #F4F6F4;
  --brand-orange: #C4461B;
  --brand-gradient: #222625;
  --brand-soft-gradient: #FFFFFF;

  --bg-canvas: #FFFFFF;
  --bg-canvas-solid: #FFFFFF;
  --bg-surface: #FFFFFF;
  --bg-surface-strong: #FFFFFF;
  --bg-subtle: #F4F6F4;
  --bg-muted: #F4F6F4;
  --bg-elevated: #FFFFFF;
  --bg-overlay: rgba(34, 38, 37, 0.42);

  --text-primary: #222625;
  --text-secondary: #666E68;
  --text-tertiary: #666E68;
  --text-disabled: #A1AAA3;
  --text-inverse: #FFFFFF;

  --border-subtle: #E5E8E5;
  --border-default: #E5E8E5;
  --border-strong: #A8B6AC;

  --status-success: #43715B;
  --status-warning: #926313;
  --status-danger: #B73730;
  --status-info: #666E68;

  --font-family-base: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif;
  --font-family-mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;

  --radius-sm: 8rpx;
  --radius-md: 8rpx;
  --radius-lg: 8rpx;
  --radius-xl: 8rpx;
  --radius-full: 9999rpx;

  --space-1: 4rpx;
  --space-2: 8rpx;
  --space-3: 12rpx;
  --space-4: 16rpx;
  --space-5: 20rpx;
  --space-6: 24rpx;
  --space-8: 32rpx;
  --space-10: 40rpx;
  --space-12: 48rpx;

  --shadow-sm: none;
  --shadow-md: none;
  --shadow-lg: 0 16rpx 48rpx rgba(34, 38, 37, 0.12);
  --shadow-glass: none;

  --glass-bg: rgba(255,255,255,0.86);
  --glass-bg-strong: rgba(255,255,255,0.94);
  --glass-border: #E5E8E5;
  --glass-backdrop: blur(24px);

  --motion-fast: 140ms;
  --motion-normal: 200ms;

  --page-max-width: 1440rpx;
}
